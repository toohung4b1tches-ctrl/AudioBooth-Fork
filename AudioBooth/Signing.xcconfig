// Signing.xcconfig
// Signing configuration for Maudiobooth.
//
// DEVELOPMENT_TEAM: your Apple team ID. For a free (Personal Team) account,
// sign in under Xcode → Settings → Accounts, then pick the team once in
// Signing & Capabilities, or paste its 10-character ID here.

DEVELOPMENT_TEAM =
ORG_IDENTIFIER = com.rathyou

// Free Apple accounts can't use iCloud. CONTRIBUTOR_BUILD turns off iCloud
// settings sync in UserPreferences.swift. Remove this line (and add the
// ubiquity-kvstore entitlement back) once you have a paid developer account.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) CONTRIBUTOR_BUILD

// Pull in local overrides if they exist (the ? makes the include optional)
#include? "Local.xcconfig"
